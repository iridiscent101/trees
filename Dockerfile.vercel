FROM dunglas/frankenphp:1-php8.4-alpine AS php

WORKDIR /app

RUN install-php-extensions bcmath exif gd intl pdo_mysql zip

FROM php AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY . .
RUN composer install --no-dev --no-interaction --no-progress --prefer-dist --optimize-autoloader

FROM node:24-alpine AS assets

WORKDIR /app

COPY --from=dependencies /app /app
RUN npm ci --ignore-scripts && npm run build && rm -rf node_modules

FROM php

COPY --from=assets /app /app
COPY Caddyfile /etc/caddy/Caddyfile

ENV PORT=80
ENV LOG_CHANNEL=stderr
ENV VIEW_COMPILED_PATH=/tmp/views

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
